def sum_intersection_features (context, g):
  sum = 0
  for elem in context:
    for i in range(18):
      sum += elem[i]*g[i]
  return sum

def sum_intersection_features_ratio (context, g):
  sum = 0
  N = 0
  for elem in context:
    N+= 1
    for i in range(18):
      sum += elem[i]*g[i]
  return sum/N

def sum_support (first_context, second_context, g):
  sum = 0
  N=0
  for elem in first_context:
    temp = elem*g
    for elem1 in second_context:
      N+=1
      elem1_has_features = 1
      for i in range(18):
        if (temp[i] > elem1[i]):
           elem1_has_features = 0
      if elem1_has_features:
         sum+=1
  return sum/N
